<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd" beStrictAboutOutputDuringTests="true" failOnWarning="true" cacheDirectory=".phpunit.cache" failOnDeprecation="true" displayDetailsOnTestsThatTriggerDeprecations="true">
  <testsuites>
    <testsuite name="lib">
      <directory>tests/lib</directory>
    </testsuite>
  </testsuites>
  <source baseline="phpunit.baseline.xml" ignoreIndirectDeprecations="false" ignoreSuppressionOfDeprecations="true">
    <include>
      <directory>src/lib</directory>
      <directory>src/bundle</directory>
      <directory>src/contracts</directory>
    </include>
  </source>
</phpunit>
